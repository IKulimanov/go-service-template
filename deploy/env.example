# /srv/secrets/SERVICE_NAME.env — секреты и настройки сервиса. Права 0600, правится в панели homelab («Сейф»).
# BOT_DB задаёт compose (/data/SERVICE_NAME.db), здесь его не указывать.
# Слово «Обязателен» в комментарии над переменной: без неё update.sh не запустит сервис и попросит заполнить.

# Токен из BotFather. Обязателен.
BOT_TOKEN=

# Таймзона: от неё считается «сегодня».
BOT_TIMEZONE=Asia/Bishkek

# Ключ и адрес Gemini. В homelab их записывает update.sh, если сервис есть в clients шлюза: ключ шлюза
# и GEMINI_BASE_URL=http://llm-gateway:8080. Пустой ключ — сервис работает без модели.
GEMINI_API_KEY=
GEMINI_BASE_URL=
GEMINI_MODEL=gemini-2.5-flash
